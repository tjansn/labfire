# Copy to .kamal/secrets and fill in real values.
# .kamal/secrets is intentionally git-ignored.

# GHCR token with package push/pull scope.
# Refresh gh auth with package scopes, or set KAMAL_REGISTRY_PASSWORD in your shell.
# Example: gh auth refresh -h github.com -s write:packages -s read:packages
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

# Stable Rails secret. Generate once with: openssl rand -hex 64
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Web push notifications.
# Generate with: script/admin/create-vapid-key inside a prepared app environment.
VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
