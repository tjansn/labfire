<% account = Current.account %>

<% if account&.join_code.present? %>
  <div class="gl-invite-panel">
    <% url = join_url(account.join_code) %>

    <label class="gl-invite-field" style="--row-gap: 0.5em">
      <strong id="invite_label" class="invite-label">Join link</strong>
      <span class="gl-invite-input input input--actor">
        <%= uicon "person-add", size: 20 %>
        <input type="text" class="input" id="invite_url" value="<%= url %>" aria-labelledby="invite_label" readonly>
      </span>
    </label>

    <div class="gl-invite-actions">
      <%= link_to_zoom_qr_code(url) do %>
        <span class="for-screen-reader">Show join link QR code</span>
        <%= uicon "qr-code", size: 20 %>
      <% end %>

      <%= button_to_copy_to_clipboard(url) do %>
        <span class="for-screen-reader">Copy join link</span>
        <%= uicon "copy-paste", size: 20 %>
      <% end %>

      <%= web_share_session_button(url, "Link to join Labfire", "Hit this link to join me in Labfire and start chatting.") do %>
        <span class="for-screen-reader">Share join link</span>
        <%= uicon "share", size: 20 %>
      <% end %>

      <% if Current.user.can_administer? %>
        <%= button_to account_join_code_path, class: "btn btn--regenerate" do %>
          <%= uicon "refresh", size: 20 %>
          <span class="for-screen-reader">Regenerate join link</span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
