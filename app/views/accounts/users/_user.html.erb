<li class="gl-settings-person <%= "banned" if user.banned? %>">
  <figure class="avatar gl-settings-person__avatar flex-item-no-shrink">
    <%= avatar_tag user, loading: :lazy %>
  </figure>

  <div class="gl-settings-person__details min-width">
    <div class="overflow-ellipsis"><strong><%= user.name %></strong></div>
    <span class="gl-settings-person__role">
      <% if user.banned? %>
        Banned
      <% elsif user.bot? %>
        Bot
      <% elsif user.administrator? %>
        Administrator
      <% else %>
        Member
      <% end %>
    </span>
  </div>

  <div class="gl-settings-person__actions">
    <% if Current.user.can_administer? && user.active? %>
      <% unless user.bot? %>
        <%= form_with model: user, url: account_user_path(user), data: { controller: "form" }, method: :patch do | form | %>
          <label class="btn gl-settings-icon-btn" for="<%= dom_id(user, :role) %>" title="Toggle administrator role">
            <span class="for-screen-reader">Role: <%= user.administrator? ? "Administrator" : "Member" %></span>
            <%= uicon "crown", size: 18 %>
            <%= form.check_box :role, { data: { action: "form#submit" }, hidden: true, id: dom_id(user, :role), disabled: user == Current.user }, "administrator", "member" %>
          </label>
        <% end %>
      <% end %>

      <% unless user == Current.user %>
        <%= button_to account_user_path(user), method: :delete, class: "btn btn--negative gl-settings-icon-btn", data: {
              turbo_confirm: "Are you sure you want to permanently remove this person from the account? This can’t be undone."} do %>
          <%= uicon "minus", size: 18 %>
          <span class="for-screen-reader">Delete <%= user.name %></span>
        <% end %>
      <% end %>
    <% end %>

    <% if user == Current.user %>
      <%= link_to user_profile_path, class: "btn gl-settings-icon-btn", target: "_top", title: "My settings" do %>
        <%= uicon "pencil", size: 18 %>
        <span class="for-screen-reader">My settings</span>
      <% end %>
    <% end %>
  </div>
</li>
