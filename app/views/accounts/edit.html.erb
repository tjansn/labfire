<% @page_title = "Account settings" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to_last_room_visited %>
  </div>

  <% if Current.user.administrator? %>
    <div class="gl-settings-nav-actions flex align-center gap flex-item-justify-end">
      <%= link_to account_bots_path, class: "btn gl-settings-nav-action", style: "view-transition-name: chat-bots" do %>
        <%= uicon "bot", size: 20 %>
        <span>Bots</span>
      <% end %>

      <%= link_to edit_account_custom_styles_path, class: "btn gl-settings-nav-action", style: "view-transition-name: custom-styles" do %>
        <%= uicon "art", size: 20 %>
        <span>Custom styles</span>
      <% end %>
    </div>
  <% end %>
<% end %>

<section class="gl-settings-page" style="view-transition-name: account-settings">
  <header class="gl-settings-hero">
    <div class="gl-settings-hero__media" data-controller="upload-preview">
      <% if Current.user.can_administer? %>
        <%= form_with model: @account, url: account_path, method: :patch, class: "gl-settings-logo-form", data: { controller: "form" } do |form| %>
          <label class="btn avatar input--file account-logo gl-settings-logo">
            <%= image_tag fresh_account_logo_path, role: "presentation", size: 72, data: { upload_preview_target: "image" } %>
            <%= form.file_field :logo, class: "input", accept: "image/*",
                  data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
            <span class="for-screen-reader">Upload logo</span>
          </label>
        <% end %>

        <% if @account.logo.attached? %>
          <%= button_to fresh_account_logo_path, method: :delete, class: "btn btn--negative gl-settings-logo__delete", aria: { label: "Delete logo" } do %>
            <%= uicon "minus", size: 16 %>
            <span class="for-screen-reader">Delete logo</span>
          <% end %>
        <% end %>
      <% else %>
        <%= account_logo_tag style: "txt-xx-large center gl-settings-logo" %>
      <% end %>
    </div>

    <div class="gl-settings-hero__copy">
      <p class="gl-kicker">Server settings</p>
      <h1><%= @account.name %></h1>
      <p>Manage your Labfire server identity, invitations, access rules, and people.</p>
    </div>
  </header>

  <% if Current.user.can_administer? %>
    <article class="gl-settings-card gl-settings-card--identity">
      <header class="gl-settings-card__header">
        <div>
          <p class="gl-kicker">Identity</p>
          <h2>Server details</h2>
        </div>
        <p>Name and present this server consistently across Labfire.</p>
      </header>

      <%= form_with model: @account, url: account_path, data: { controller: "form" }, class: "gl-settings-name-form" do |form| %>
        <%= translation_button(:account_name) %>

        <label class="gl-settings-field flex-item-grow">
          <span>Server name</span>
          <%= form.text_field :name, class: "input", autocomplete: "off", placeholder: "Name this account", autofocus: true,
                data: { action: "keydown.enter->form#submit" } %>
        </label>

        <%= form.button class: "btn btn--reversed gl-settings-submit", type: "submit" do %>
          <%= uicon "check", size: 20 %>
          <span>Save</span>
        <% end %>
      <% end %>
    </article>

    <article class="gl-settings-card gl-settings-card--access">
      <header class="gl-settings-card__header">
        <div>
          <p class="gl-kicker">Access</p>
          <h2>Room creation</h2>
        </div>
        <p>Control who can create new shared rooms.</p>
      </header>

      <%= form_with model: @account, url: account_path, method: :put, data: { controller: "form" }, class: "gl-settings-toggle-row" do |form| %>
        <div class="gl-settings-toggle-row__copy">
          <%= uicon "crown", size: 18 %>
          <div>
            <strong>Require administrator approval</strong>
            <span>Only admins can create new shared rooms.</span>
          </div>
        </div>

        <%= form.fields_for :settings, @account.settings do |settings_form| %>
          <%= settings_form.hidden_field :restrict_room_creation_to_administrators,
              value: !Current.account&.settings&.restrict_room_creation_to_administrators? %>
        <% end %>

        <label class="switch">
          <input type="checkbox"
                class="switch__input"
                role="switch"
                aria-label="Require administrator approval to create new rooms"
                <%= "checked" if Current.account&.settings&.restrict_room_creation_to_administrators? %>
                data-action="change->form#submit">
          <span class="switch__btn round" aria-hidden="true"></span>
        </label>
      <% end %>
    </article>
  <% end %>

  <article id="invite" class="gl-settings-card gl-settings-card--invite">
    <header class="gl-settings-card__header">
      <div>
        <p class="gl-kicker">Invite</p>
        <h2>Bring people in</h2>
      </div>
      <p>Share this private join link with teammates you trust.</p>
    </header>

    <%= render "accounts/invite" %>
  </article>

  <article class="gl-settings-card gl-settings-card--people">
    <header class="gl-settings-card__header">
      <div>
        <p class="gl-kicker">People</p>
        <h2>Members</h2>
      </div>
      <p><%= pluralize(@administrators.size + @members.size, "person") %> can access this server.</p>
    </header>

    <menu class="gl-settings-people-list flex flex-column gap margin-none unpad">
      <turbo-frame id="account_users">
        <%= render partial: "accounts/users/user", collection: @administrators, as: :user %>

        <% if @administrators.any? && @members.any? %>
          <hr class="separator full-width" style="--border-style: solid">
        <% end %>

        <%= render partial: "accounts/users/user", collection: @members, as: :user %>
        <%= render "accounts/users/next_page_container", page: @page.next_param unless @page.last? %>
      </turbo-frame>
    </menu>
  </article>
</section>

<% content_for :footer do %>
  <div class="txt-align-center center margin-block-double txt-subtle">Labfire version <%= version_badge %></div>
<% end %>
