<%= sidebar_turbo_frame_tag do %>
  <%= turbo_stream_from :rooms %>
  <%= turbo_stream_from Current.user, :rooms %>

  <div class="sidebar__container overflow-y overflow-hide-scrollbar"
      data-controller="badge-dot"
      data-badge-dot-unread-class="unread"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <div class="gl-sidebar-brand">
      <span class="gl-sidebar-brand__identity">
        <%= image_tag fresh_account_logo_path(size: "small"), width: 28, height: 28, alt: "", aria: { hidden: "true" }, class: "gl-sidebar-brand__logo" %>
        <span class="gl-sidebar-brand__name"><%= Current.account.name %></span>
      </span>
      <button class="btn gl-sidebar-brand__menu" type="button"
          data-controller="menu-toggle"
          data-menu-toggle-target-selector-value="#sidebar"
          data-menu-toggle-open-class-value="menu-open"
          data-action="menu-toggle#toggle"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="topbar_menu_panel"
          aria-label="Open account menu">
        <%= uicon "menu", size: 18 %>
        <span class="for-screen-reader">Open menu</span>
      </button>
    </div>

    <div class="gl-mobile-account-menu" role="menu" aria-label="Account menu">
      <%= render "layouts/account_menu_items" %>
    </div>

    <details class="gl-app-nav-section gl-app-nav-section--directs" data-controller="details" open>
      <summary class="gl-app-nav__label gl-app-nav__summary">
        <span>Personal messages</span>

        <%= link_to new_rooms_direct_path, class: "btn gl-app-nav__add", data: { turbo_frame: "direct_rooms_control", action: "click->details#open" }, aria: { label: "New personal message" } do %>
          <%= uicon "add", size: 16 %>
          <span class="for-screen-reader">New personal message</span>
        <% end %>
      </summary>

      <turbo-frame id="direct_rooms_control" target="_top">
        <div class="directs gap">
          <div id="direct_rooms" contents data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem">
            <%= render partial: "users/sidebars/rooms/direct", collection: @direct_memberships, as: :membership, cached: true %>
          </div>

          <div contents>
            <%= render partial: "users/sidebars/rooms/direct_placeholder", collection: @direct_placeholder_users, as: :user %>
          </div>
        </div>
      </turbo-frame>
    </details>

    <details class="gl-app-nav-section gl-app-nav-section--rooms" data-controller="details" open>
      <summary class="gl-app-nav__label gl-app-nav__summary">
        <span>Rooms</span>

        <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
          <%= link_to new_rooms_open_path, class: "btn gl-app-nav__add", data: { turbo_frame: "shared_rooms_control", action: "click->details#open" }, aria: { label: "New room" } do %>
            <%= uicon "add", size: 16, style: "view-transition-name: new-room" %>
            <span class="for-screen-reader">New room</span>
          <% end %>
        <% end %>
      </summary>

      <turbo-frame id="shared_rooms_control" target="_top">
        <div class="rooms position-relative flex flex-column gap">
          <div id="shared_rooms" contents data-controller="sorted-list">
            <% @other_memberships.each do |membership| %>
              <%= render "users/sidebars/rooms/shared", room: membership.room, unread: membership.unread? %>
            <% end %>
          </div>
        </div>
      </turbo-frame>
    </details>

  </div>
<% end %>
