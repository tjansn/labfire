<% if turbo_frame_request_for?("direct_rooms_control") %>
  <turbo-frame id="direct_rooms_control" target="_top">
    <div class="directs directs--new flex flex-column gap">
      <%= render "rooms/directs/form", room: @room, compact: true %>

      <span class="txt-small translucent pad-inline-half center">Type names to start a personal message…</span>
    </div>
  </turbo-frame>
<% else %>
  <% @page_title = "New personal message" %>

  <% content_for :nav do %>
    <div class="flex-item-justify-start">
      <%= link_back_to_last_room_visited %>
    </div>
  <% end %>

  <section class="gl-direct-new-page" style="view-transition-name: new-direct-message">
    <article class="gl-direct-new-card">
      <header class="gl-direct-new-header">
        <span class="gl-direct-new-icon" aria-hidden="true">
          <%= uicon "messages-add", size: 24 %>
        </span>

        <div>
          <p class="gl-kicker">Personal messages</p>
          <h1>New private chat</h1>
          <p>Choose who you want to message. Labfire will reuse an existing private chat when one already exists.</p>
        </div>
      </header>

      <%= render "rooms/directs/form", room: @room %>
    </article>
  </section>
<% end %>
