<% content_for :footer do %>
  <% composer_placeholder = room.direct? ? "Message #{room_display_name(room)}" : "Message ##{room.name}" %>

  <div class="composer position-relative"
      data-controller="typing-notifications" data-typing-notifications-active-class="typing-indicator--active">
    <turbo-frame id="composer-frame">
      <%= composer_form_tag(room) do |form| %>
        <fieldset data-composer-target="fields" contents>
          <div class="flex flex-column">
            <div class="composer__filelist flex flex--align-center gap flex-wrap" data-composer-target="fileList"></div>

            <div class="composer__input composer__input--panel input input--actor full-width">
              <div class="composer__input-text composer__editor flex flex-column flex-item-grow min-width">
                <%= form.rich_text_area :body,
                      rows: 1,
                      class: "input",
                      placeholder: composer_placeholder,
                      aria: { multiline: "true", label: composer_placeholder },
                      data: {
                        controller: "rich-autocomplete",
                        action: rich_text_data_actions,
                        rich_autocomplete_url_value: autocompletable_users_path(room_id: room.id),
                        permitted_attachment_types: "application/vnd.actiontext.opengraph-embed",
                        composer_target: "text" } %>
              </div>

              <div class="composer__actions flex align-center justify-space-between full-width">
                <div class="composer__actions-start flex align-center">
                  <label class="btn btn--borderless flex-item-no-shrink composer__attachment-btn input--file" title="Attach a file">
                    <%= uicon "attachment" %>
                    <input type="file" data-action="composer#filePicked" multiple aria-label="Attach a file">
                    <span class="for-screen-reader">Attach a file</span>
                  </label>

                  <%= tag.button type: "button",
                        class: "btn btn--borderless flex-item-no-shrink composer__rich-text-btn",
                        title: "Toggle text formatting",
                        aria: { label: "Toggle text formatting", pressed: "false" },
                        data: { action: "composer#toggleToolbar", composer_toolbar_toggle: true } do %>
                    <%= uicon "text-options" %>
                    <span class="for-screen-reader">Toggle text formatting</span>
                  <% end %>

                  <%= render "messages/boosts/composer_emoji_picker" %>
                </div>

                <div class="composer__actions-end flex align-center">
                  <%= form.button name: "send", type: "submit", data: { action: "composer#submit" },
                        class: "btn btn--reversed flex-item-no-shrink composer__send-btn",
                        title: "Send message", aria: { label: "Send message" } do %>
                    <%= uicon "send", size: 16 %>
                    <span class="for-screen-reader">Send message</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </fieldset>

        <div class="typing-indicator gap txt-small align-center flex-inline" data-typing-notifications-target="indicator">
          <div class="typing-indicator__author spinner" data-typing-notifications-target="author"></div>
        </div>

        <%= form.hidden_field :client_message_id, data: { composer_target: "clientid" } %>
      <% end %>
    </turbo-frame>

    <%= form_with model: CustomEmoji.new, url: custom_emojis_path,
          html: { id: "composer_custom_emoji_form", multipart: true, hidden: true },
          data: { turbo_frame: "_top" } do %>
    <% end %>
  </div>
<% end %>
