#!/usr/bin/env bash
set -euo pipefail

# Optional: point KAMAL_SSH_AUTH_SOCK at the SSH agent socket you want Kamal to use.
# When unset or invalid, the existing SSH_AUTH_SOCK is left unchanged.
if [ -n "${KAMAL_SSH_AUTH_SOCK:-}" ] && [ -S "$KAMAL_SSH_AUTH_SOCK" ]; then
  export SSH_AUTH_SOCK="$KAMAL_SSH_AUTH_SOCK"
fi

if command -v nix >/dev/null 2>&1; then
  exec nix shell nixpkgs#kamal -c kamal "$@"
fi

if command -v kamal >/dev/null 2>&1; then
  exec kamal "$@"
fi

cat >&2 <<'MSG'
Kamal is not installed and nix is not available.
Install Kamal 2.x, then retry. See: https://kamal-deploy.org/docs/installation
MSG
exit 127
